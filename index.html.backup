  { en: 'Goblet squat', ar: 'سكوات دمبل', muscle: 'Quads · Glutes', home: true, equip: ['dumbbells', 'all'], sets: '3 × 8–12', query: 'goblet squat tutorial' },
  { en: 'Leg press', ar: 'ليج برس', muscle: 'Quads · Glutes', home: false, equip: ['machines', 'all'], sets: '3 × 10–12', query: 'leg press machine proper form' },
  { en: 'Romanian deadlift', ar: 'رفعة رومانية', muscle: 'Hamstrings · Glutes', home: true, equip: ['dumbbells', 'all'], sets: '3 × 8–12', query: 'dumbbell romanian deadlift tutorial' },
  { en: 'Glute bridge', ar: 'رفع الحوض', muscle: 'Glutes · Hamstrings', home: true, equip: ['bodyweight', 'bands', 'dumbbells', 'all'], sets: '3 × 12–15', query: 'glute bridge exercise tutorial' },
  { en: 'Dumbbell shoulder press', ar: 'ضغط كتف دمبل', muscle: 'Shoulders · Triceps', home: true, equip: ['dumbbells', 'all'], sets: '3 × 8–12', query: 'dumbbell shoulder press proper form' },
  { en: 'Lateral raise', ar: 'رفرفة جانبي', muscle: 'Shoulders', home: true, equip: ['dumbbells', 'all'], sets: '3 × 12–15', query: 'dumbbell lateral raise tutorial' },
  { en: 'Biceps curl', ar: 'بايسبس كيرل', muscle: 'Biceps', home: true, equip: ['dumbbells', 'bands', 'all'], sets: '3 × 10–15', query: 'dumbbell biceps curl tutorial' },
  { en: 'Triceps extension', ar: 'تمديد ترايسبس', muscle: 'Triceps', home: true, equip: ['dumbbells', 'bands', 'all'], sets: '3 × 10–15', query: 'dumbbell triceps extension tutorial' },
  { en: 'Plank', ar: 'بلانك', muscle: 'Core', home: true, equip: ['bodyweight', 'bands', 'dumbbells', 'machines', 'all'], sets: '3 × 20–45 sec', query: 'plank proper form tutorial' },
  { en: 'Dead bug', ar: 'ديد باج للبطن', muscle: 'Core', home: true, equip: ['bodyweight', 'bands', 'dumbbells', 'machines', 'all'], sets: '3 × 8–12 / side', query: 'dead bug core exercise tutorial' },
  { en: 'Calf raise', ar: 'رفع السمانة', muscle: 'Calves', home: true, equip: ['bodyweight', 'dumbbells', 'all'], sets: '3 × 12–20', query: 'standing calf raise tutorial' },
  { en: 'Seated cable row', ar: 'تجديف كيبل', muscle: 'Back', home: false, equip: ['machines', 'all'], sets: '3 × 8–12', query: 'seated cable row tutorial' },
  { en: 'Leg curl machine', ar: 'ثني الرجل ماكينة', muscle: 'Hamstrings', home: false, equip: ['machines', 'all'], sets: '3 × 10–15', query: 'seated leg curl machine tutorial' },
  { en: 'Band pull-apart', ar: 'فتح باستيك للكتف', muscle: 'Rear delts · Upper back', home: true, equip: ['bands'], sets: '3 × 12–20', query: 'resistance band pull apart exercise' },
  { en: 'Walking lunge', ar: 'لونجز مشي', muscle: 'Legs · Glutes', home: true, equip: ['bodyweight', 'dumbbells', 'all'], sets: '3 × 8–12 / leg', query: 'walking lunge proper form' }
];

function renderExerciseLibrary() {
  const q = ($('exerciseSearch')?.value || '').toLowerCase();
  const place = $('planPlace')?.value || 'gym', equip = $('planEquipment')?.value || 'all';
  const list = exerciseData.filter(e => ((e.en + ' ' + e.ar + ' ' + e.muscle).toLowerCase().includes(q)) && (place !== 'home' || e.home) && (equip === 'all' || e.equip.includes(equip) || e.equip.includes('all')));
  
  $('exerciseLibrary').innerHTML = list.map(e => `<article class="exercise-card">
    <span class="pill">${e.muscle}</span>
    <h3>${state.lang === 'ar' ? e.ar : e.en}</h3>
    <p>${e.sets} · ${tr('controlled reps, good form', 'تكرارات متحكم فيها وأداء سليم')}</p>
    <a href="https://www.youtube.com/results?search_query=${encodeURIComponent(e.query)}" target="_blank" rel="noopener">
      ▶ ${tr('Watch form on YouTube', 'شوف طريقة الأداء على يوتيوب')} ↗
    </a>
  </article>`).join('') || `<div class="empty">${tr('No exercises match those filters.', 'مفيش تمارين مطابقة للاختيارات.')}</div>`;
}

function generateWorkoutPlan() {
  const days = Number($('planDays').value), place = $('planPlace').value, equip = $('planEquipment').value, level = $('planLevel').value;
  let split = $('planSplit').value;
  if (split === 'auto') split = days <= 3 ? 'fullbody' : days === 4 ? 'upperlower' : 'ppl';
  if (days < 3 && split === 'ppl') split = 'fullbody';
  
  const templates = {
    ppl: ['Push', 'Pull', 'Legs'],
    upperlower: ['Upper body', 'Lower body'],
    bro: ['Chest', 'Back', 'Legs', 'Shoulders', 'Arms'],
    arnold: ['Chest + Back', 'Shoulders + Arms', 'Legs'],
    phul: ['Upper body', 'Lower body', 'Upper body', 'Lower body'],
    pplul: ['Push', 'Pull', 'Legs', 'Upper body', 'Lower body'],
    torso: ['Upper body', 'Lower body'],
    strengthsplit: ['Strength Upper', 'Strength Lower'],
    home: ['Full body', 'Core + Abs'],
    fullbody: ['Full body A', 'Full body B', 'Full body C']
  };
  
  const names = templates[split] || templates.fullbody;
  const pool = exerciseData.filter(e => (place !== 'home' || e.home) && (equip === 'all' || e.equip.includes(equip) || e.equip.includes('all')));
  const muscleSets = {
    'Push': /Chest|Shoulders|Triceps/i,
    'Pull': /Back|Biceps/i,
    'Legs': /Legs|Quads|Hamstrings|Glutes|Calves/i,
    'Upper body': /Chest|Back|Shoulders|Biceps|Triceps/i,
    'Lower body': /Legs|Quads|Hamstrings|Glutes|Calves|Core/i,
    'Chest': /Chest|Triceps/i,
    'Back': /Back|Biceps/i,
    'Shoulders': /Shoulders|Core/i,
    'Arms': /Biceps|Triceps/i,
    'Chest + Back': /Chest|Back/i,
    'Shoulders + Arms': /Shoulders|Biceps|Triceps/i,
    'Full body': /Chest|Back|Legs|Glutes|Shoulders|Core/i,
    'Full body A': /Chest|Back|Legs|Glutes|Shoulders|Core/i,
    'Full body B': /Chest|Back|Legs|Glutes|Shoulders|Core/i,
    'Full body C': /Chest|Back|Legs|Glutes|Shoulders|Core/i,
    'Strength Upper': /Chest|Back|Shoulders|Biceps|Triceps/i,
    'Strength Lower': /Legs|Quads|Hamstrings|Glutes|Calves|Core/i,
    'Core + Abs': /Core|Abs/i
  };

  let html = `<div class="card">
    <div class="eyebrow">YOUR GENERATED ROUTINE</div>
    <h2>${days} ${tr('training days per week', 'أيام تمرين في الأسبوع')}</h2>
    <p class="muted">${place === 'home' ? tr('Home plan', 'نظام البيت') : tr('Gym plan', 'نظام الجيم')} · ${tr(level, level === 'beginner' ? 'مبتدئ' : level === 'intermediate' ? 'متوسط' : 'متقدم')} · ${tr('Choose a goal and adjust your schedule any time.', 'اختار هدفك وعدّل جدولك في أي وقت.')}</p>`;

  for (let d = 0; d < days; d++) {
    let nm = names[d % names.length];
    let pattern = muscleSets[nm] || /Chest|Back|Legs|Glutes|Shoulders|Core/i;
    let arr = pool.filter(e => pattern.test(e.muscle));
    if (split === 'phul' && d % 2 === 0) arr = arr.filter(e => /Chest|Back|Legs|Quads|Hamstrings/i.test(e.muscle));
    arr = arr.slice(0, level === 'beginner' ? 4 : 6);
    if (!arr.length) arr = pool.slice(0, 4);

    html += `<div class="plan-day">
      <h3>Day ${d + 1} · ${nm}</h3>
      <ul>${arr.map(e => `<li><strong>${state.lang === 'ar' ? e.ar : e.en}</strong> — ${e.sets} · <a style="color:var(--accent-lime)" target="_blank" rel="noopener" href="https://www.youtube.com/results?search_query=${encodeURIComponent(e.query)}">▶ YouTube</a></li>`).join('')}</ul>
    </div>`;
  }

  html += `<p class="note">${tr('Rest at least one day between hard sessions for the same muscles. Warm up for 5–10 minutes. This is a starter template; exercise technique and recovery matter more than lifting heavy.', 'سيب يوم راحة على الأقل بين التمارين الشديدة لنفس العضلات، وسخّن 5–10 دقايق. ده جدول مبدئي؛ الأداء السليم والاستشفاء أهم من الوزن التقيل.')}</p></div>`;

  $('generatedPlan').innerHTML = html;
  renderExerciseLibrary();
}

$('exerciseSearch')?.addEventListener('input', renderExerciseLibrary);
$('planPlace')?.addEventListener('change', renderExerciseLibrary);
$('planEquipment')?.addEventListener('change', renderExerciseLibrary);

function addWorkout() {
  let name = $('workoutName')?.value.trim() || 'Workout', duration = Number($('workoutDuration')?.value) || 45;
  let date = $('workoutDate')?.value || today();
  state.workouts.push({ name, type: 'Strength', duration, date, uid: Date.now() });
  persist();
  renderWorkouts();
  renderDashboard();
  toast(tr('Workout saved. Nice work!', 'اتسجل التمرين، عاش!'));
}

const WEEK_DAYS = [['Sunday', 'الأحد'], ['Monday', 'الاثنين'], ['Tuesday', 'الثلاثاء'], ['Wednesday', 'الأربعاء'], ['Thursday', 'الخميس'], ['Friday', 'الجمعة'], ['Saturday', 'السبت']];
const SPLIT_OPTIONS = [
  ['Rest', 'راحة'], ['Chest + Shoulders', 'صدر + كتف'], ['Chest + Triceps', 'صدر + ترايسبس'],
  ['Back + Biceps', 'ظهر + بايسبس'], ['Shoulders + Arms', 'كتف + ذراع'], ['Legs', 'رجل'],
  ['Push', 'Push — صدر وكتف وترايسبس'], ['Pull', 'Pull — ظهر وبايسبس'],
  ['Upper body', 'جزء علوي'], ['Lower body', 'جزء سفلي'], ['Full body', 'جسم كامل'],
  ['Arms', 'ذراع'], ['Chest', 'صدر'], ['Back', 'ظهر'], ['Shoulders', 'كتف'],
  ['Core + Abs', 'بطن وكور'], ['Glutes + Hamstrings', 'مؤخرة وخلفية رجل'],
  ['Cardio + Core', 'كارديو وبطن'], ['Custom', 'اختار عضلاتك يدويًا']
];

function defaultCustomWeek() {
  return WEEK_DAYS.map(([en, ar], i) => ({ day: en, group: ['Chest + Shoulders', 'Rest', 'Back + Biceps', 'Rest', 'Legs', 'Shoulders + Arms', 'Rest'][i] }));
}

function customWeek() {
  try {
    const saved = JSON.parse(localStorage.getItem('fitforge-custom-week') || 'null');
    return Array.isArray(saved) && saved.length === 7 ? saved : defaultCustomWeek();
  } catch (e) {
    return defaultCustomWeek();
  }
}

function renderCustomWeek() {
  const week = customWeek();
  $('customWeekRows').innerHTML = week.map((d, i) => `<div class="rowitem" style="align-items:center;gap:14px;flex-wrap:wrap">
    <div style="min-width:110px;flex:1">
      <strong>${state.lang === 'ar' ? WEEK_DAYS[i][1] : WEEK_DAYS[i][0]}</strong>
      <small>${state.lang === 'ar' ? 'خطة اليوم' : 'Day plan'}</small>
    </div>
    <div class="field" style="min-width:210px;flex:2;margin-bottom:0">
      <select aria-label="Workout for ${d.day}" onchange="updateCustomDay(${i},this.value)">
        ${SPLIT_OPTIONS.map(([en, ar]) => `<option value="${en}" ${d.group === en ? 'selected' : ''}>${state.lang === 'ar' ? ar : en}</option>`).join('')}
      </select>
    </div>
    <button class="btn secondary sm" onclick="cycleCustomDay(${i})">${state.lang === 'ar' ? 'تغيير سريع' : 'Quick change'} ↻</button>
  </div>`).join('');
}

function updateCustomDay(i, group) {
  const w = customWeek();
  w[i].group = group;
  saveAccountLocal('fitforge-custom-week', w);
  renderCustomWeek();
}

function cycleCustomDay(i) {
  const w = customWeek(), idx = SPLIT_OPTIONS.findIndex(x => x[0] === w[i].group);
  w[i].group = SPLIT_OPTIONS[(idx + 1) % SPLIT_OPTIONS.length][0];
  saveAccountLocal('fitforge-custom-week', w);
  renderCustomWeek();
}

function loadCustomTemplate() {
  const t = $('customTemplate').value;
  let groups;
  if (t === 'ppl') groups = ['Push', 'Pull', 'Legs', 'Rest', 'Push', 'Pull', 'Rest'];
  else if (t === 'upperlower') groups = ['Upper body', 'Lower body', 'Rest', 'Upper body', 'Lower body', 'Rest', 'Rest'];
  else if (t === 'fullbody') groups = ['Full body', 'Rest', 'Full body', 'Rest', 'Full body', 'Rest', 'Rest'];
  else if (t === 'bro') groups = ['Chest', 'Back', 'Legs', 'Shoulders', 'Arms', 'Rest', 'Rest'];
  else if (t === 'arnold') groups = ['Chest + Back', 'Shoulders + Arms', 'Legs', 'Chest + Back', 'Shoulders + Arms', 'Legs', 'Rest'];
  else if (t === 'phul') groups = ['Upper body', 'Lower body', 'Rest', 'Upper body', 'Lower body', 'Rest', 'Rest'];
  else if (t === 'pplul') groups = ['Push', 'Pull', 'Legs', 'Upper body', 'Lower body', 'Rest', 'Rest'];
  else if (t === 'torso') groups = ['Upper body', 'Lower body', 'Rest', 'Upper body', 'Lower body', 'Rest', 'Rest'];
  else if (t === 'strength') groups = ['Full body', 'Rest', 'Full body', 'Rest', 'Full body', 'Rest', 'Rest'];
  else if (t === 'home') groups = ['Full body', 'Rest', 'Full body', 'Core + Abs', 'Rest', 'Full body', 'Rest'];
  else groups = ['Chest + Shoulders', 'Rest', 'Back + Biceps', 'Rest', 'Legs', 'Shoulders + Arms', 'Rest'];
  
  const w = WEEK_DAYS.map(([day], i) => ({ day, group: groups[i] }));
  saveAccountLocal('fitforge-custom-week', w);
  renderCustomWeek();
}

function resetCustomPlan() {
  saveAccountLocal('fitforge-custom-week', defaultCustomWeek());
  $('customTemplate').value = 'manual';
  renderCustomWeek();
  $('customPlanOutput').innerHTML = '';
}

function saveCustomPlan() {
  const week = customWeek(), place = $('planPlace').value, equip = $('planEquipment').value;
  const pool = exerciseData.filter(e => (place !== 'home' || e.home) && (equip === 'all' || e.equip.includes(equip) || e.equip.includes('all')));
  const matches = (group) => {
    if (group === 'Rest') return [];
    if (group === 'Push') return pool.filter(e => /Chest|Shoulders|Triceps/i.test(e.muscle));
    if (group === 'Pull') return pool.filter(e => /Back|Biceps/i.test(e.muscle));
    if (group === 'Legs' || group === 'Lower body') return pool.filter(e => /Legs|Quads|Hamstrings|Glutes|Calves/i.test(e.muscle));
    if (group === 'Upper body') return pool.filter(e => /Chest|Back|Shoulders|Biceps|Triceps/i.test(e.muscle));
    if (group === 'Full body') return pool.filter(e => /Chest|Back|Legs|Glutes|Shoulders|Core/i.test(e.muscle));
    if (group === 'Arms' || group === 'Shoulders + Arms') return pool.filter(e => /Biceps|Triceps|Shoulders/i.test(e.muscle));
    if (group === 'Chest + Back') return pool.filter(e => /Chest|Back/i.test(e.muscle));
    if (group === 'Chest + Shoulders') return pool.filter(e => /Chest|Shoulders/i.test(e.muscle));
    if (group === 'Chest + Triceps') return pool.filter(e => /Chest|Triceps/i.test(e.muscle));
    if (group === 'Back + Biceps') return pool.filter(e => /Back|Biceps/i.test(e.muscle));
    if (group === 'Shoulders') return pool.filter(e => /Shoulders/i.test(e.muscle));
    if (group === 'Chest') return pool.filter(e => /Chest/i.test(e.muscle));
    if (group === 'Back') return pool.filter(e => /Back/i.test(e.muscle));
    if (group === 'Core + Abs') return pool.filter(e => /Core|Abs/i.test(e.muscle));
    if (group === 'Glutes + Hamstrings') return pool.filter(e => /Glutes|Hamstrings/i.test(e.muscle));
    if (group === 'Cardio + Core') return pool.filter(e => /Core|Abs/i.test(e.muscle));
    return pool.slice(0, 5);
  };

  const output = week.map((d, i) => {
    const arr = matches(d.group).slice(0, 5);
    return `<div class="plan-day">
      <h3>${state.lang === 'ar' ? WEEK_DAYS[i][1] : d.day} · ${state.lang === 'ar' ? (SPLIT_OPTIONS.find(x => x[0] === d.group)?.[1] || d.group) : d.group}</h3>
      ${d.group === 'Rest' ? `<p class="muted">${state.lang === 'ar' ? 'استشفاء وراحة' : 'Recovery day'}</p>` : arr.length ? `<ul>${arr.map(e => `<li><strong>${state.lang === 'ar' ? e.ar : e.en}</strong> — ${e.sets} · <a style="color:var(--accent-lime)" target="_blank" rel="noopener" href="https://www.youtube.com/results?search_query=${encodeURIComponent(e.query)}">▶ YouTube</a></li>`).join('')}</ul>` : `<p class="muted">${state.lang === 'ar' ? 'مش لاقي تمارين مطابقة للمعدات المختارة.' : 'No matching exercises for selected equipment.'}</p>`}
    </div>`;
  }).join('');

  $('customPlanOutput').innerHTML = `<div class="card" style="margin-top:16px">
    <div class="eyebrow">SAVED CUSTOM WEEK</div>
    <h2>${state.lang === 'ar' ? 'جدولك الأسبوعي' : 'Your weekly schedule'}</h2>
    ${output}
    <p class="note">${state.lang === 'ar' ? 'تقدر تغيّر أي يوم في أي وقت. تكرار العضلات متاح، لكن خُد بالك من الراحة والاستشفاء وتجنب تدريب نفس العضلة بشدة كل يوم.' : 'Edit any day anytime. Muscle groups can repeat, but allow enough recovery and avoid training the same muscle hard every day.'}</p>
  </div>`;

  saveAccountLocal('fitforge-custom-week', week);
  toast(state.lang === 'ar' ? 'تم حفظ جدولك المخصص' : 'Custom week saved');
}

function renderWorkouts() {
  let arr = state.workouts.slice().reverse();
  $('totalWorkouts').textContent = state.workouts.length;
  $('totalMinutes').textContent = state.workouts.reduce((a, w) => a + w.duration, 0);
  $('workoutLog').innerHTML = arr.map(w => `<div class="rowitem">
    <div>
      <strong>${w.name}</strong>
      <small>${w.type || 'Strength'} · ${w.duration} min · ${w.date}</small>
    </div>
    <button onclick="deleteWorkout(${w.uid})">${tr('Remove', 'حذف')}</button>
  </div>`).join('') || `<div class="empty">${tr('No workouts logged yet. Generate a plan and log your sessions.', 'لسه مفيش تمارين مسجلة. اعمل جدول وسجّل تمرينك.')}</div>`;

  if ($('exerciseLibrary')) renderExerciseLibrary();
  if ($('customWeekRows')) renderCustomWeek();
}

function deleteWorkout(uid) {
  state.workouts = state.workouts.filter(w => w.uid !== uid);
  persist();
}

function clearWorkouts() {
  state.workouts = [];
  persist();
  toast(tr('Workout history cleared', 'تم مسح سجل التمارين'));
}

function saveProfile() {
  let age = Number($('age').value),
    height = Number($('height').value),
    weight = Number($('startWeight').value),
    activity = Number($('activity').value),
    goal = $('goal').value,
    target = Number($('targetWeight').value),
    sex = $('sex').value;
  if (!(age >= 13 && height >= 100 && height <= 250 && weight >= 25 && weight <= 350 && target >= 25)) {
    toast(tr('Check your profile values', 'راجع البيانات المدخلة'));
    return;
  }
  let bmr = 10 * weight + 6.25 * height - 5 * age + (sex === 'male' ? 5 : sex === 'female' ? -161 : -78),
    maintenance = bmr * activity,
    calories = Math.round(maintenance + (goal === 'bulk' ? 200 : (goal === 'loss' || goal === 'cut') ? -300 : 0));
  let protein = Math.round(weight * 1.8), fats = Math.round(weight * .9), carbs = Math.max(0, Math.round((calories - protein * 4 - fats * 9) / 4));
  state.profile = { age, sex, height, weight, activity, goal, target, calories, protein, carbs, fats };
  $('profileResult').innerHTML = `<div class="result" style="margin-top:14px">
    <div class="muted">${tr('Estimated maintenance', 'سعرات الحفاظ التقديرية')}: ${fmt(maintenance)} kcal</div>
    <div class="resultnum">${fmt(calories)} kcal/day</div>
    <div class="muted">${tr('Suggested starting target', 'الهدف المقترح كبداية')}</div>
  </div>`;
  persist();
  toast(tr('Your plan has been updated', 'تم تحديث خطتك'));
}

function renderProfile() {
  let p = state.profile;
  $('age').value = p.age;
  $('sex').value = p.sex;
  $('height').value = p.height;
  $('startWeight').value = p.weight;
  $('activity').value = p.activity;
  $('goal').value = p.goal;
  $('targetWeight').value = p.target;
  $('planCalories').textContent = fmt(p.calories) + ' kcal';
  $('planLabel').textContent = tr(({ bulk: 'Bulking', loss: 'Weight loss', cut: 'Cutting', maintain: 'Maintain weight' })[p.goal], ({ bulk: 'تضخيم', loss: 'تخسيس', cut: 'تنشيف', maintain: 'تثبيت الوزن' })[p.goal]);
  $('planProtein').textContent = p.protein + ' g';
  $('planCarbs').textContent = p.carbs + ' g';
  $('planFats').textContent = p.fats + ' g';
}

function renderAll() {
  renderDashboard();
  renderFoods();
  renderWeights();
  renderWorkouts();
  renderProfile();
}

$('weightDate').value = today();
if ($('workoutDate')) $('workoutDate').value = today();
if ($('bodyDate')) $('bodyDate').value = today();

const swapFoods = {
  chicken: { en: 'Chicken breast', ar: 'صدور فراخ', kcal: 165, p: 31, c: 0, f: 3.6 },
  egg: { en: 'Egg', ar: 'بيض', kcal: 155, p: 13, c: 1.1, f: 11 },
  rice: { en: 'Cooked rice', ar: 'رز مطبوخ', kcal: 130, p: 2.7, c: 28.2, f: 0.3 },
  ful: { en: 'Fava beans', ar: 'فول', kcal: 110, p: 7.6, c: 19.7, f: 0.4 },
  koshari: { en: 'Koshari', ar: 'كشري', kcal: 160, p: 5, c: 27, f: 3.2 },
  lentils: { en: 'Cooked lentils', ar: 'عدس مطبوخ', kcal: 116, p: 9, c: 20, f: 0.4 },
  potato: { en: 'Boiled potato', ar: 'بطاطس مسلوقة', kcal: 87, p: 1.9, c: 20.1, f: 0.1 }
};

function bodyEntries() {
  try { return JSON.parse(localStorage.getItem('fitforge-body-entries') || '[]'); } catch { return []; }
}

function previewBodyPhoto(e) {
  const f = e.target.files && e.target.files[0];
  if (!f) return;
  if (f.size > 5 * 1024 * 1024) {
    toast(state.lang === 'ar' ? 'الصورة أكبر من 5 ميجابايت' : 'Image must be under 5 MB');
    e.target.value = '';
    return;
  }
  const reader = new FileReader();
  reader.onload = () => {
    const im = $('bodyPhotoPreview');
    im.src = reader.result;
    im.style.display = 'block';
    window.bodyPhotoData = reader.result;
  };
  reader.readAsDataURL(f);
}

function saveBodyEntry() {
  const entry = {
    date: $('bodyDate').value || today(),
    weight: Number($('bodyWeight').value) || null,
    waist: Number($('bodyWaist').value) || null,
    chest: Number($('bodyChest').value) || null,
    arm: Number($('bodyArm').value) || null,
    thigh: Number($('bodyThigh').value) || null,
    photo: window.bodyPhotoData || null
  };
  if (!entry.weight && !entry.waist && !entry.chest && !entry.arm && !entry.thigh && !entry.photo) {
    toast(state.lang === 'ar' ? 'أدخل قياسًا واحدًا على الأقل' : 'Enter at least one measurement');
    return;
  }
  const list = bodyEntries();
  list.push(entry);
  try {
    saveAccountLocal('fitforge-body-entries', list);
    window.bodyPhotoData = null;
    $('bodyPhoto').value = '';
    $('bodyPhotoPreview').style.display = 'none';
    renderBodyEntries();
    toast(state.lang === 'ar' ? 'تم حفظ التقدم' : 'Progress saved');
  } catch (err) {
    toast(state.lang === 'ar' ? 'المساحة غير كافية لحفظ الصورة؛ جرّب صورة أصغر' : 'Not enough browser storage; try a smaller photo');
  }
}

function renderBodyEntries() {
  const el = $('bodyHistory');
  if (!el) return;
  const list = bodyEntries().slice().reverse();
  el.innerHTML = list.map((x, i) => `<div class="rowitem">
    <div>
      <strong>${x.date} · ${x.weight ? x.weight + ' kg' : 'Measurements'}</strong>
      <small>${[['Waist', x.waist], ['Chest', x.chest], ['Arm', x.arm], ['Thigh', x.thigh]].filter(a => a[1]).map(a => a[0] + ': ' + a[1] + ' cm').join(' · ') || 'No measurements'} ${x.photo ? ' · Photo saved' : ''}</small>
    </div>
    <button onclick="deleteBodyEntry(${list.length - 1 - i})">${state.lang === 'ar' ? 'حذف' : 'Delete'}</button>
  </div>`).join('') || `<div class="empty">${state.lang === 'ar' ? 'لسه مفيش قياسات محفوظة' : 'No measurements saved yet'}</div>`;
}

function deleteBodyEntry(reverseIndex) {
  const a = bodyEntries();
  a.splice(reverseIndex, 1);
  saveAccountLocal('fitforge-body-entries', a);
  renderBodyEntries();
}

function compareSwap() {
  const a = swapFoods[$('swapFrom').value], b = swapFoods[$('swapTo').value], g = Math.max(10, Math.min(1500, Number($('swapGrams').value) || 100)), scale = g / 100;
  const out = $('swapResult');
  out.style.display = 'block';
  out.innerHTML = `<div class="grid" style="grid-template-columns:repeat(2,minmax(0,1fr));gap:12px">
    <div>
      <small class="muted">${state.lang === 'ar' ? 'الأصلية' : 'Original'}</small>
      <h3 style="margin:4px 0 2px;font-size:16px">${state.lang === 'ar' ? a.ar : a.en}</h3>
      <strong style="color:var(--accent-lime);font-size:18px">${Math.round(a.kcal * scale)} kcal</strong>
      <p class="muted" style="margin-top:4px">P ${Math.round(a.p * scale * 10) / 10}g · C ${Math.round(a.c * scale * 10) / 10}g · F ${Math.round(a.f * scale * 10) / 10}g</p>
    </div>
    <div>
      <small class="muted">${state.lang === 'ar' ? 'البديل' : 'Alternative'}</small>
      <h3 style="margin:4px 0 2px;font-size:16px">${state.lang === 'ar' ? b.ar : b.en}</h3>
      <strong style="color:var(--accent-lime);font-size:18px">${Math.round(b.kcal * scale)} kcal</strong>
      <p class="muted" style="margin-top:4px">P ${Math.round(b.p * scale * 10) / 10}g · C ${Math.round(b.c * scale * 10) / 10}g · F ${Math.round(b.f * scale * 10) / 10}g</p>
    </div>
  </div>
  <p style="margin-top:12px;font-size:13px">${state.lang === 'ar' ? 'الفرق التقريبي' : 'Approximate difference'}: <strong style="color:var(--accent-lime)">${Math.round((b.kcal - a.kcal) * scale)} kcal</strong>, protein <strong style="color:var(--accent-lime)">${Math.round((b.p - a.p) * scale * 10) / 10} g</strong>.</p>
  <small class="note">${state.lang === 'ar' ? 'القيم تختلف حسب طريقة التحضير والعلامة التجارية.' : 'Values vary by preparation and brand.'}</small>`;
}

async function generateBudgetPlan() {
  const budget = Math.max(50, Math.min(50000, Number($('mealBudget').value) || 500));
  const goal = $('mealGoal').value, avoid = $('mealAvoid').value.trim(), en = state.lang !== 'ar';
  const profile = state.profile || {};
  const userKey = currentUser && currentUser.email ? 'fitforge-week-plan:' + currentUser.email : 'fitforge-week-plan:guest';
  const targetCalories = Number(profile.calories) || null;
  const payload = {
    budget,
    goal,
    avoid,
    language: en ? 'en' : 'ar',
    profile: {
      age: Number(profile.age) || null,
      height: Number(profile.height) || null,
      weight: Number(profile.weight) || null,
      activity: profile.activity || 'moderate',
      dailyCalories: targetCalories,
      protein: Number(profile.protein) || null
    }
  };

  $('budgetPlanResult').innerHTML = `<div class="result">
    <strong>${en ? 'Building a personalized 7-day plan with AI…' : 'الذكاء الاصطناعي بيجهّز لك نظام مختلف لمدة 7 أيام…'}</strong>
    <p class="note">${en ? 'The menu is generated from your budget, goal and preferences; it is not a fixed template.' : 'الخطة بتتولد حسب ميزانيتك وهدفك واختياراتك، مش قائمة ثابتة بتتكرر.'}</p>
  </div>`;

  const buttons = document.querySelectorAll('button[onclick="generateBudgetPlan()"]');
  buttons.forEach(b => {
    b.disabled = true;
    b.dataset.oldText = b.textContent;
    b.textContent = en ? 'Generating…' : 'جاري التجهيز…';
  });

  try {
    const res = await fetch('/api/generate-budget-plan', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'AI plan request failed');
    if (!Array.isArray(data.days) || data.days.length !== 7) throw new Error(en ? 'AI did not return all 7 days. Please try again.' : 'الذكاء الاصطناعي مرجعش الأيام السبعة كاملة. جرّب تاني.');

    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const goalNames = en ? { bulk: 'Muscle gain', loss: 'Weight loss', cut: 'Cutting', maintain: 'Maintain weight' } : { bulk: 'تضخيم', loss: 'تخسيس', cut: 'تنشيف', maintain: 'تثبيت الوزن' };
    let weeklyCost = 0;

    const daysHtml = data.days.map((day, i) => {
      const meals = Array.isArray(day.meals) ? day.meals : [];
      const kcal = Number(day.calories) || meals.reduce((a, m) => a + (Number(m.calories) || 0), 0);
      const protein = Number(day.protein) || meals.reduce((a, m) => a + (Number(m.protein) || 0), 0);
      const carbs = Number(day.carbs) || meals.reduce((a, m) => a + (Number(m.carbs) || 0), 0);
      const fat = Number(day.fat) || meals.reduce((a, m) => a + (Number(m.fat) || 0), 0);
      const cost = Number(day.estimated_cost) || 0;
      weeklyCost += cost;

      const mealsHtml = meals.map(m => {
        const foods = String(m.foods || '').split(/\s*(?:;|\n|\|)\s*/).map(x => x.trim()).filter(Boolean);
        return `<article class="meal-card">
          <div>
            <div class="meal-title">${esc(m.name || (en ? 'Meal' : 'وجبة'))}</div>
            <div class="meal-foods">
              ${foods.map(food => `<div class="meal-food">${esc(food)}</div>`).join('') || `<div class="meal-food">${esc(m.foods || '')}</div>`}
              ${m.grams ? `<div class="note">${en ? 'Portion guide' : 'الكميات'}: ${esc(m.grams)}</div>` : ''}
              ${m.notes ? `<div class="note">${esc(m.notes)}</div>` : ''}
            </div>
          </div>
          <div class="meal-macros">
            <strong>${Math.round(Number(m.calories) || 0)} kcal</strong>
            <small>Protein ${Math.round(Number(m.protein) || 0)} g</small>
            <small>Carbs ${Math.round(Number(m.carbs) || 0)} g</small>
            <small>Fat ${Math.round(Number(m.fat) || 0)} g</small>
            <small>${en ? 'Est. cost' : 'التكلفة'}: ${Math.round(Number(m.estimated_cost) || 0)} EGP</small>
          </div>
        </article>`;
      }).join('');

      return `<details class="plan-day" ${i === 0 ? 'open' : ''} style="margin:12px 0">
        <summary style="cursor:pointer;font-weight:800;padding:6px 0">${esc(day.day || (en ? ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'][i] : ['الأحد', 'الاثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'][i]))} · ${kcal} kcal · P ${protein}g · ${en ? 'estimated' : 'تكلفة تقديرية'} ${Math.round(cost)} EGP</summary>
        <div style="padding:10px 0 0">${mealsHtml}<p class="note" style="margin-top:8px">${en ? 'Daily total' : 'إجمالي اليوم'}: <strong>${kcal} kcal · Protein ${protein}g · Carbs ${carbs}g · Fat ${fat}g</strong></p></div>
      </details>`;
    }).join('');

    const shopping = Array.isArray(data.shopping_list) ? data.shopping_list : [];
    const shoppingHtml = shopping.length ? `<h3 style="margin-top:20px;font-size:16px">${en ? 'Shopping list' : 'قائمة المشتريات'}</h3><div class="food-list" style="margin-top:10px">${shopping.map(x => `<div class="fooditem"><div><strong>${esc(x.item)}</strong><small>${esc(x.quantity || '')}</small></div><strong class="kcal">${Math.round(Number(x.estimated_cost) || 0)} EGP</strong></div>`).join('')}</div>` : '';
    const result = { budget, goal, avoid, createdAt: new Date().toISOString(), days: data.days, shopping_list: shopping, estimated_week_cost: weeklyCost, summary: data.summary || '' };
    saveAccountLocal(userKey, result);

    $('budgetPlanResult').innerHTML = `<div class="result">
      <div class="eyebrow">${en ? 'AI-GENERATED 7-DAY MEAL PLAN' : 'خطة أسبوعية مولّدة بالذكاء الاصطناعي'}</div>
      <div class="resultnum">${budget.toLocaleString()} EGP <small style="font-size:14px;color:var(--text-muted)">/ ${en ? 'weekly budget' : 'ميزانية الأسبوع'}</small></div>
      <p style="margin:6px 0"><strong>${esc(goalNames[goal] || goalNames.maintain)}</strong></p>
      <p style="color:var(--text-muted);font-size:13px">${esc(data.summary || '')}</p>
      <div class="daily-summary" style="margin:16px 0">
        <div class="mini-stat"><small>${en ? 'Estimated food cost' : 'تكلفة الأكل التقديرية'}</small><strong>${Math.round(weeklyCost)} EGP</strong></div>
        <div class="mini-stat"><small>${en ? 'Budget remaining' : 'المتبقي من الميزانية'}</small><strong>${Math.round(budget - weeklyCost)} EGP</strong></div>
      </div>
      <p class="note">${en ? 'AI-generated menu. Price estimates use recent Egyptian market benchmarks and can vary by shop and governorate; verify before shopping. If the estimated cost exceeds your budget, regenerate or adjust quantities.' : 'الخطة مولّدة بالذكاء الاصطناعي. تقديرات الأسعار مبنية على مؤشرات سوق مصر الحديثة وقد تختلف حسب المحل والمحافظة؛ راجع الأسعار قبل الشراء. لو التكلفة أعلى من الميزانية، جرّب توليد خطة جديدة أو تعديل الكميات.'}</p>
      <h3 style="margin-top:18px;font-size:16px">${en ? 'Daily meals' : 'وجبات كل يوم'}</h3>
      ${daysHtml}
      ${shoppingHtml}
      <p class="note" style="margin-top:14px">${en ? 'Food estimates can vary by brand, recipe and cooking oil. This is not medical advice; avoid restrictive diets, especially if under 18.' : 'القيم تختلف حسب نوع المنتج والوصفة وزيت الطهي. دي معلومات عامة وليست نصيحة طبية؛ تجنب الأنظمة القاسية خصوصًا لو أقل من 18 سنة.'}</p>
    </div>`;
  } catch (err) {
    $('budgetPlanResult').innerHTML = `<div class="result">
      <strong style="color:var(--accent-rose)">${en ? 'Could not generate the AI meal plan' : 'مقدرناش نولّد خطة الأكل بالذكاء الاصطناعي'}</strong>
      <p style="margin-top:6px">${String(err.message || err).replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]))}</p>
      <p class="note">${en ? 'Check your Gemini API key, model access and internet connection, then try again.' : 'راجع مفتاح Gemini والموديل والإنترنت، وبعدها جرّب تاني.'}</p>
    </div>`;
  } finally {
    buttons.forEach(b => {
      b.disabled = false;
      b.textContent = b.dataset.oldText || (en ? 'Generate weekly plan' : 'اعمل خطة الأسبوع');
    });
  }
}

function initLanguage() {
  document.documentElement.lang = state.lang;
  document.documentElement.dir = state.lang === 'ar' ? 'rtl' : 'ltr';
  $('langBtn').innerHTML = `<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg> <span>${state.lang === 'en' ? 'عربي' : 'English'}</span>`;
  document.querySelectorAll('[data-en]').forEach(el => {
    if (el.dataset[state.lang] !== undefined) {
      if (el.tagName === 'OPTION') el.textContent = el.dataset[state.lang];
      else el.innerHTML = el.dataset[state.lang];
    }
  });
  $('foodSearch').placeholder = tr('Search eggs, koshari, rice…', 'ابحث عن بيض، كشري، رز…');
}

initLanguage();
renderAll();
</script>
</body>
</html>
